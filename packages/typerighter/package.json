{
  "$schema": "https://json.schemastore.org/package",
  "name": "typerighter",
  "version": "0.23.0",
  "description": "Typedown: A typed content framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/huydo862003/typerighter.git",
    "directory": "packages/typedown"
  },
  "type": "module",
  "bin": {
    "typerighter": "./bin/typerighter.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/node/plugin/index.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared.js"
    },
    "./client/theme-default": {
      "types": "./dist/client/theme-default/index.d.ts",
      "import": "./dist/client/theme-default.js"
    },
    "./style.css": "./dist/typerighter.css",
    "./fonts.css": "./dist/fonts.css",
    "./math.css": "./dist/math.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "vite-plugin",
    "rolldown-plugin",
    "typedown"
  ],
  "author": "Huy-DNA <huydo862003@gmail.com>",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/vue": "^2.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.39.0",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@typerighter/rpc-client": "workspace:*",
    "@typerighter/rpc-server": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "shiki": "^4.4.3",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "temml": "^0.13.5",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@hdnax/nuclint": "^0.17.5",
    "@types/node": "^26.4.1",
    "minisearch": "^7.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
