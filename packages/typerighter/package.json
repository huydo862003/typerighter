{
  "$schema": "https://json.schemastore.org/package",
  "name": "typerighter",
  "version": "0.5.0",
  "description": "Typedown: A typed content framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/huydo862003/typerighter.git",
    "directory": "packages/typedown"
  },
  "type": "module",
  "bin": {
    "typerighter": "./bin/typerighter.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/node/plugin/index.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./client/theme-default": {
      "types": "./dist/client/theme-default/index.d.ts",
      "import": "./dist/client/theme-default.js"
    },
    "./style.css": "./dist/typerighter.css"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "vite-plugin",
    "rolldown-plugin",
    "typedown"
  ],
  "author": "Huy-DNA <huydo862003@gmail.com>",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.30.0",
    "@mdit-vue/plugin-frontmatter": "^3.0.2",
    "@mdit-vue/plugin-headers": "^3.0.2",
    "@mdit-vue/plugin-title": "^3.0.2",
    "@mdit-vue/plugin-toc": "^3.0.2",
    "@mdit-vue/shared": "^3.0.2",
    "@mdit/plugin-anchor": "^1.1.1",
    "@mdit/plugin-attrs": "^1.1.1",
    "@mdit/plugin-container": "^1.0.1",
    "@mdit/plugin-emoji": "^1.1.0",
    "@mdit/plugin-katex": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.1",
    "@shikijs/markdown-it": "^4.3.1",
    "@shikijs/transformers": "^4.3.1",
    "@shikijs/types": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typerighter/rpc-client": "workspace:*",
    "@typerighter/rpc-server": "workspace:*",
    "@vitejs/plugin-vue": "^5.0.0 || ^6.0.0",
    "@vue/shared": "^3.5.41",
    "cac": "^7.0.0",
    "image-size": "^2.0.2",
    "js-yaml": "^5.2.3",
    "katex": "^0.18.1",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^9.0.0",
    "markdown-it-async": "^2.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "picocolors": "^1.1.1",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@hdnax/nuclint": "^0.17.4",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-container": "^4.0.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "~24.13.3",
    "minisearch": "^7.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
