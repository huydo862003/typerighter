  "scripts": {
    "build:grammar": "json5 -o syntaxes/typedown.tmLanguage.json syntaxes/typedown.tmLanguage.json5",
    "build:rust": "cargo build -p typedown-server && TYPEDOWN_BINARY_SOURCE=local node scripts/setup-binary.mjs",
    "check-types": "tsc --noEmit",
    "fetch:staging": "TYPEDOWN_BINARY_SOURCE=staging node scripts/setup-binary.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "pnpm run build:grammar && pnpm run check-types && pnpm run lint && node esbuild.js",
    "build:local": "pnpm run build:rust && pnpm run build",
    "build:staging": "pnpm run fetch:staging && pnpm run build",
    "build:tests": "tsc -p . --outDir out",
    "dev": "npm-run-all -p dev:rust dev:esbuild dev:tsc",
    "dev:esbuild": "node esbuild.js --watch",
    "dev:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "dev:rust": "cargo watch --workdir ../.. -w crates -s \"cargo build -p typedown-server && TYPEDOWN_BINARY_SOURCE=local node editors/vscode/scripts/setup-binary.mjs\"",
    "dev:staging": "npm-run-all -p dev:esbuild dev:tsc",
    "dev:tests": "tsc -p . -w --outDir out",
    "test": "vscode-test",
    "pretest": "pnpm run build:tests && pnpm run build && pnpm run lint",
    "package": "pnpm run build:grammar && pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "json5": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
