{
  "$schema": "https://json.schemastore.org/package",
  "license": "AGPL-3.0-only",
  "publisher": "hdnax",
  "name": "typedown-vscode",
  "displayName": "Typerighter",
  "description": "vscode extension providing lsp services for the typedown language",
  "private": true,
  "author": "Huy-DNA <huydo862003@gmail.com>",
  "version": "0.20.1",
  "icon": "icons/typedown.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:typedown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "typedown",
        "aliases": [
          "Typedown",
          "typedown"
        ],
        "extensions": [
          ".td"
        ],
        "icon": {
          "light": "./icons/typedown.svg",
          "dark": "./icons/typedown.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[typedown]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "grammars": [
      {
        "language": "typedown",
        "scopeName": "source.typedown",
        "path": "./syntaxes/typedown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.math.typedown": "latex"
        }
      },
      {
        "scopeName": "typedown.javascript.codeblock",
        "path": "./syntaxes/javascript-codeblock.json",
        "injectTo": [
          "source.typedown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript"
        }
      },
      {
        "scopeName": "typedown.typescript.codeblock",
        "path": "./syntaxes/typescript-codeblock.json",
